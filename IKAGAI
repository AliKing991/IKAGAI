function scoreRiasec() {
  const scores = { R:0, I:0, A:0, S:0, E:0, C:0 };
  const counts = { R:0, I:0, A:0, S:0, E:0, C:0 };
  RIASEC_QUESTIONS.forEach(q => {
    counts[q.type]++;
    scores[q.type] += state.riasec[q.id] || 0;
  });
  Object.keys(scores).forEach(k => {
    scores[k] = counts[k] ? Math.round((scores[k] / (counts[k] * 5)) * 100) : 0;
  });
  return scores;
}

function scoreBigFive() {
  const traits = { Openness: [], Conscientiousness: [], Extraversion: [], Agreeableness: ['Emotional Stability'] };
  const result = { Openness: 0, Conscientiousness: 0, Extraversion: 0, Agreeableness: 0, 'Emotional Stability': 0 };
  const counts = { Openness: 0, Conscientiousness: 0, Extraversion: 0, Agreeableness: 0, 'Emotional Stability': 0 };

  BIGFIVE_QUESTIONS.forEach(q => {
    const val = state.bigfive[q.id];
    if (val === undefined) return;
    const scored = q.reverse ? (6 - val) : val;
    result[q.trait] += scored;
    counts[q.trait]++;
  });

  Object.keys(result).forEach(k => {
    result[k] = counts[k] ? Math.round((result[k] / (counts[k] * 5)) * 100) : 50;
  });
  return result;
}

function computeIkigaiScore() {
  // Parse free-text answers for keyword richness
  const dims = ['love', 'good', 'need', 'paid'];
  const scores = {};
  let totalLen = 0;

  dims.forEach(dim => {
    const qs = IKIGAI_QUESTIONS.filter(q => q.dimension === dim);
    let text = '';
    qs.forEach(q => { text += (document.getElementById(q.id)?.value || '') + ' '; });
    const words = text.trim().split(/\s+/).filter(w => w.length > 3);
    const richness = Math.min(100, words.length * 4 + (text.length > 20 ? 30 : 0));
    scores[dim] = richness;
    totalLen += richness;
  });

  return { dims: scores, overall: Math.round(totalLen / 4) };
}

// ═══════════════════════════════════════════════════════════════
// O*NET-STYLE CAREER MATCHING
// ═══════════════════════════════════════════════════════════════

function matchCareers(riasecScores, skills, bigfive) {
  const topRiasec = Object.entries(riasecScores).sort((a,b) => b[1] - a[1]).slice(0, 3).map(e => e[0]);

  return OCCUPATIONS.map(occ => {
    // RIASEC overlap score (0-40)
    const riasecOverlap = occ.riasec.filter(r => topRiasec.includes(r)).length;
    const riasecScore = (riasecOverlap / 3) * 40;

    // Skill overlap score (0-40)
    const skillOverlap = occ.skills.filter(s => skills.includes(s)).length;
    const skillScore = Math.min(40, (skillOverlap / occ.skills.length) * 40);

    // Big Five alignment (0-20)
    let bfScore = 10;
    if (bigfive) {
      if (occ.title.includes('Designer') && bigfive.Openness > 60) bfScore += 8;
      if (occ.title.includes('Analyst') && bigfive.Conscientiousness > 60) bfScore += 8;
      if (occ.title.includes('Manager') && bigfive.Extraversion > 60) bfScore += 8;
      if (occ.title.includes('Consultant') && bigfive.Agreeableness > 60) bfScore += 8;
    }

    const total = Math.round(riasecScore + skillScore + bfScore);
    return { ...occ, fitScore: Math.min(100, total) };
  }).sort((a,b) => b.fitScore - a.fitScore);
}

