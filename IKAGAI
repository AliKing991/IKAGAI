<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ikigai Compass — Discover Your Purpose</title>
<style>
:root {
  --bg-deep: #0a0e17;
  --bg-card: #131a2b;
  --bg-card-hover: #1a2438;
  --border: #1e2d4a;
  --accent: #4f8cff;
  --accent-glow: rgba(79,140,255,0.25);
  --accent2: #00d4aa;
  --accent3: #ff6b9d;
  --accent4: #ffc857;
  --text: #e8eef7;
  --text-dim: #8899b4;
  --text-muted: #5a6a85;
  --radius: 14px;
  --radius-sm: 8px;
  --font: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: var(--font);
  background: var(--bg-deep);
  color: var(--text);
  min-height: 100vh;
  line-height: 1.6;
  overflow-x: hidden;
}
body::before {
  content: '';
  position: fixed; inset: 0;
  background:
    radial-gradient(ellipse 80% 50% at 20% 10%, rgba(79,140,255,0.08), transparent),
    radial-gradient(ellipse 60% 40% at 80% 80%, rgba(0,212,170,0.06), transparent),
    radial-gradient(ellipse 50% 30% at 50% 50%, rgba(255,107,157,0.04), transparent);
  pointer-events: none; z-index: 0;
}
.app { position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; padding: 24px 20px 80px; }

/* ── Header ── */
header { text-align: center; padding: 48px 0 32px; }
header .logo { font-size: 13px; letter-spacing: 6px; text-transform: uppercase; color: var(--accent); font-weight: 600; margin-bottom: 12px; }
header h1 { font-size: clamp(28px, 5vw, 48px); font-weight: 800; letter-spacing: -1px; background: linear-gradient(135deg, #fff 30%, var(--accent) 70%, var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
header p { color: var(--text-dim); max-width: 560px; margin: 14px auto 0; font-size: 15px; }

/* ── Progress ── */
.progress-bar { display: flex; gap: 6px; margin: 32px 0 40px; }
.progress-step { flex: 1; height: 4px; background: var(--border); border-radius: 4px; transition: all .5s cubic-bezier(.4,0,.2,1); }
.progress-step.active { background: var(--accent); box-shadow: 0 0 12px var(--accent-glow); }
.progress-step.done { background: var(--accent2); }

/* ── Cards ── */
.card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; margin-bottom: 20px; transition: border-color .3s, box-shadow .3s; }
.card:hover { border-color: #2a3d5e; box-shadow: 0 4px 24px rgba(0,0,0,0.3); }
.card h2 { font-size: 18px; font-weight: 700; margin-bottom: 6px; display: flex; align-items: center; gap: 10px; }
.card h2 .badge { font-size: 10px; padding: 2px 8px; border-radius: 20px; background: rgba(79,140,255,0.15); color: var(--accent); font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
.card .sub { color: var(--text-dim); font-size: 13px; margin-bottom: 20px; }

/* ── Form Elements ── */
.field { margin-bottom: 18px; }
.field label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text-dim); }
.field input[type="text"], .field textarea, .field select {
  width: 100%; padding: 12px 14px; background: var(--bg-deep); border: 1px solid var(--border);
  border-radius: var(--radius-sm); color: var(--text); font-family: var(--font); font-size: 14px;
  transition: border-color .2s, box-shadow .2s; resize: vertical;
}
.field input:focus, .field textarea:focus, .field select:focus {
  outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow);
}
.field textarea { min-height: 80px; }

/* ── Likert Scale ── */
.likert { display: flex; gap: 8px; flex-wrap: wrap; }
.likert button {
  flex: 1; min-width: 44px; padding: 10px 4px; background: var(--bg-deep); border: 1px solid var(--border);
  border-radius: var(--radius-sm); color: var(--text-dim); font-weight: 600; font-size: 13px;
  cursor: pointer; transition: all .2s; text-align: center;
}
.likert button:hover { border-color: var(--accent); color: var(--text); }
.likert button.selected { background: var(--accent); border-color: var(--accent); color: #fff; box-shadow: 0 0 16px var(--accent-glow); }
.likert-labels { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); margin-top: 6px; padding: 0 4px; }

/* ── Skill Tags ── */
.skill-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.skill-tag {
  padding: 8px 16px; background: var(--bg-deep); border: 1px solid var(--border); border-radius: 24px;
  font-size: 13px; cursor: pointer; transition: all .2s; user-select: none;
}
.skill-tag:hover { border-color: var(--accent); }
.skill-tag.active { background: rgba(79,140,255,0.15); border-color: var(--accent); color: var(--accent); }

/* ── Buttons ── */
.btn { padding: 14px 32px; border: none; border-radius: var(--radius-sm); font-family: var(--font); font-size: 15px; font-weight: 700; cursor: pointer; transition: all .3s; display: inline-flex; align-items: center; gap: 8px; }
.btn-primary { background: linear-gradient(135deg, var(--accent), #6c5ce7); color: #fff; box-shadow: 0 4px 20px var(--accent-glow); }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px var(--accent-glow); }
.btn-primary:disabled { opacity: .4; cursor: not-allowed; transform: none; }
.btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--text-dim); }
.btn-ghost:hover { border-color: var(--accent); color: var(--text); }
.btn-row { display: flex; gap: 12px; justify-content: space-between; margin-top: 28px; }

/* ── Results ── */
.result-section { display: none; }
.result-section.visible { display: block; animation: fadeUp .6s cubic-bezier(.16,1,.3,1); }
@keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }

.profile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
.profile-item { background: var(--bg-deep); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 16px; text-align: center; }
.profile-item .label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 6px; }
.profile-item .value { font-size: 22px; font-weight: 800; }
.profile-item .value.accent { color: var(--accent); }
.profile-item .value.accent2 { color: var(--accent2); }
.profile-item .value.accent3 { color: var(--accent3); }
.profile-item .value.accent4 { color: var(--accent4); }

/* ── Bar Chart ── */
.bar-chart { display: flex; flex-direction: column; gap: 12px; }
.bar-row { display: flex; align-items: center; gap: 12px; }
.bar-label { width: 90px; font-size: 13px; font-weight: 600; color: var(--text-dim); text-align: right; flex-shrink: 0; }
.bar-track { flex: 1; height: 10px; background: var(--bg-deep); border-radius: 6px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 6px; transition: width 1s cubic-bezier(.16,1,.3,1); width: 0; }
.bar-value { width: 48px; font-size: 13px; font-weight: 700; text-align: right; flex-shrink: 0; }

/* ── Career Cards ── */
.career-card { background: var(--bg-deep); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 18px; margin-bottom: 12px; transition: border-color .3s; }
.career-card:hover { border-color: var(--accent); }
.career-card .title { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.career-card .meta { font-size: 12px; color: var(--text-muted); margin-bottom: 8px; }
.career-card .desc { font-size: 13px; color: var(--text-dim); line-height: 1.5; }
.career-card .skills-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.career-card .skill-chip { font-size: 11px; padding: 3px 10px; border-radius: 12px; background: rgba(79,140,255,0.1); color: var(--accent); }

/* ── Roadmap ── */
.roadmap-phase { position: relative; padding-left: 32px; margin-bottom: 24px; }
.roadmap-phase::before { content: ''; position: absolute; left: 8px; top: 0; bottom: -24px; width: 2px; background: var(--border); }
.roadmap-phase:last-child::before { display: none; }
.roadmap-phase .dot { position: absolute; left: 2px; top: 4px; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--accent); background: var(--bg-deep); z-index: 1; }
.roadmap-phase.completed .dot { background: var(--accent2); border-color: var(--accent2); }
.roadmap-phase .phase-title { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
.roadmap-phase .phase-duration { font-size: 11px; color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
.roadmap-phase .phase-desc { font-size: 13px; color: var(--text-dim); }
.roadmap-phase .phase-actions { list-style: none; margin-top: 8px; }
.roadmap-phase .phase-actions li { font-size: 13px; color: var(--text-dim); padding: 3px 0 3px 16px; position: relative; }
.roadmap-phase .phase-actions li::before { content: '→'; position: absolute; left: 0; color: var(--accent); }

/* ── Loading ── */
.loading { display: none; text-align: center; padding: 60px 0; }
.loading.visible { display: block; }
.spinner { width: 48px; height: 48px; border: 3px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 20px; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading p { color: var(--text-dim); font-size: 14px; }
.loading .sub { font-size: 12px; color: var(--text-muted); margin-top: 6px; }

/* ── API Key Banner ── */
.api-banner { background: linear-gradient(135deg, rgba(79,140,255,0.1), rgba(0,212,170,0.08)); border: 1px solid rgba(79,140,255,0.25); border-radius: var(--radius-sm); padding: 14px 18px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.api-banner .icon { font-size: 20px; }
.api-banner p { font-size: 12px; color: var(--text-dim); flex: 1; min-width: 200px; }
.api-banner input { padding: 8px 12px; background: var(--bg-deep); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 12px; font-family: monospace; width: 220px; }
.api-banner input:focus { outline: none; border-color: var(--accent); }

/* ── Responsive ── */
@media (max-width: 600px) {
  .app { padding: 16px 14px 60px; }
  .card { padding: 20px; }
  .btn { padding: 12px 24px; font-size: 14px; width: 100%; justify-content: center; }
  .btn-row { flex-direction: column; }
  .profile-grid { grid-template-columns: repeat(2, 1fr); }
  .bar-label { width: 70px; font-size: 11px; }
  .api-banner { flex-direction: column; align-items: stretch; }
  .api-banner input { width: 100%; }
}
</style>
</head>
<body>

<div class="app">
  <header>
    <div class="logo">Ikigai Compass</div>
    <h1>Discover Your Reason for Being</h1>
    <p>A psychometric and AI-driven engine that maps your passions, skills, market value, and world-need into a precise career roadmap.</p>
  </header>

  <div class="progress-bar" id="progressBar">
    <div class="progress-step active" data-step="0"></div>
    <div class="progress-step" data-step="1"></div>
    <div class="progress-step" data-step="2"></div>
    <div class="progress-step" data-step="3"></div>
    <div class="progress-step" data-step="4"></div>
  </div>

  <!-- ═══════════════ STEP 1: WHO YOU ARE ═══════════════ -->
  <div class="step-section" id="step0">
    <div class="api-banner">
      <span class="icon">🔑</span>
      <p><strong>Optional:</strong> Paste a free Google Gemini API key for enhanced AI analysis. Without it, the app uses Puter.js (no key needed, unlimited).</p>
      <input type="password" id="geminiKey" placeholder="Gemini API key (optional)">
    </div>

    <div class="card">
      <h2>Who You Are <span class="badge">Step 1 of 5</span></h2>
      <div class="sub">Basic context shapes the AI's understanding of your starting point.</div>
      <div class="field">
        <label>Your Name</label>
        <input type="text" id="userName" placeholder="e.g. Alex">
      </div>
      <div class="field">
        <label>Current Role / Situation</label>
        <input type="text" id="userRole" placeholder="e.g. Junior developer, student, career changer">
      </div>
      <div class="field">
        <label>Age Range</label>
        <select id="userAge">
          <option value="18-24">18–24</option>
          <option value="25-34" selected>25–34</option>
          <option value="35-44">35–44</option>
          <option value="45-54">45–54</option>
          <option value="55+">55+</option>
        </select>
      </div>
      <div class="field">
        <label>Briefly describe what brings you here (optional)</label>
        <textarea id="userContext" placeholder="e.g. I feel stuck in my current job and want to find work that aligns with my values..."></textarea>
      </div>
    </div>
    <div class="btn-row">
      <span></span>
      <button class="btn btn-primary" onclick="goToStep(1)">Begin Assessment →</button>
    </div>
  </div>

  <!-- ═══════════════ STEP 2: RIASEC ═══════════════ -->
  <div class="step-section" id="step1" style="display:none">
    <div class="card">
      <h2>Interest Profile (RIASEC) <span class="badge">Step 2 of 5</span></h2>
      <div class="sub">Rate how much you enjoy each activity. This maps your vocational interests using Holland's validated framework.</div>
      <div id="riasecQuestions"></div>
    </div>
    <div class="btn-row">
      <button class="btn btn-ghost" onclick="goToStep(0)">← Back</button>
      <button class="btn btn-primary" onclick="goToStep(2)">Continue →</button>
    </div>
  </div>

  <!-- ═══════════════ STEP 3: IKIGAI DIMENSIONS ═══════════════ -->
  <div class="step-section" id="step2" style="display:none">
    <div class="card">
      <h2>Ikigai Dimensions <span class="badge">Step 3 of 5</span></h2>
      <div class="sub">The four pillars: what you love, what you're good at, what the world needs, and what you can be paid for.</div>
      <div id="ikigaiQuestions"></div>
    </div>
    <div class="btn-row">
      <button class="btn btn-ghost" onclick="goToStep(1)">← Back</button>
      <button class="btn btn-primary" onclick="goToStep(3)">Continue →</button>
    </div>
  </div>

  <!-- ═══════════════ STEP 4: SKILLS ═══════════════ -->
  <div class="step-section" id="step3" style="display:none">
    <div class="card">
      <h2>Skill Matrix <span class="badge">Step 4 of 5</span></h2>
      <div class="sub">Select skills you currently possess. The engine also infers skills from your RIASEC profile and Ikigai answers.</div>
      <div class="skill-grid" id="skillGrid"></div>
    </div>
    <div class="card">
      <h2>Big Five Personality <span class="badge">Optional</span></h2>
      <div class="sub">A brief personality snapshot. This refines career fit predictions.</div>
      <div id="bigfiveQuestions"></div>
    </div>
    <div class="btn-row">
      <button class="btn btn-ghost" onclick="goToStep(2)">← Back</button>
      <button class="btn btn-primary" onclick="goToStep(4)">Analyze My Ikigai →</button>
    </div>
  </div>

  <!-- ═══════════════ STEP 5: RESULTS ═══════════════ -->
  <div class="step-section" id="step4" style="display:none">
    <div class="loading" id="loading">
      <div class="spinner"></div>
      <p>Synthesizing your profile...</p>
      <div class="sub">Scoring psychometrics → mapping occupational fit → generating roadmap</div>
    </div>

    <div class="result-section" id="results">
      <!-- Profile Summary -->
      <div class="card">
        <h2>Your Ikigai Profile <span class="badge">AI Synthesis</span></h2>
        <div class="sub" id="profileNarrative"></div>
        <div class="profile-grid" id="profileGrid"></div>
      </div>

      <!-- RIASEC Chart -->
      <div class="card">
        <h2>Interest Profile (RIASEC)</h2>
        <div class="bar-chart" id="riasecChart"></div>
      </div>

      <!-- Big Five -->
      <div class="card" id="bigfiveCard">
        <h2>Personality Profile (Big Five)</h2>
        <div class="bar-chart" id="bigfiveChart"></div>
      </div>

      <!-- Career Matches -->
      <div class="card">
        <h2>Top Career Paths <span class="badge">O*NET Aligned</span></h2>
        <div class="sub">Ranked by your Ikigai fit score. Each path includes required skills and growth trajectory.</div>
        <div id="careerMatches"></div>
      </div>

      <!-- Roadmap -->
      <div class="card">
        <h2>Personalized Roadmap <span class="badge">AI-Generated</span></h2>
        <div class="sub">A concrete, time-bound plan to move from where you are to where your Ikigai points.</div>
        <div id="roadmapContainer"></div>
      </div>

      <!-- Monetization -->
      <div class="card">
        <h2>Monetization Strategy</h2>
        <div class="sub">How to translate your Ikigai into income.</div>
        <div id="monetizationContainer"></div>
      </div>

      <!-- Raw AI Analysis -->
      <div class="card" id="aiRawCard" style="display:none">
        <h2>Deep AI Analysis</h2>
        <div id="aiRawContent" style="font-size:14px; line-height:1.7; color:var(--text-dim);"></div>
      </div>
    </div>

    <div class="btn-row" id="resultActions" style="display:none">
      <button class="btn btn-ghost" onclick="location.reload()">↻ Start Over</button>
      <button class="btn btn-primary" onclick="window.print()">⬇ Download Report</button>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════════════════
// DATA LAYER
// ═══════════════════════════════════════════════════════════════

const RIASEC_QUESTIONS = [
  { id: 'r1', text: 'Fix mechanical or electronic equipment', type: 'R' },
  { id: 'r2', text: 'Work outdoors with tools or machinery', type: 'R' },
  { id: 'r3', text: 'Build or repair physical things', type: 'R' },
