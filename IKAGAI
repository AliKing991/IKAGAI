    stmt.style.cssText = 'background:linear-gradient(135deg,rgba(79,140,255,0.12),rgba(0,212,170,0.08));border-color:rgba(79,140,255,0.3);margin-bottom:20px;';
    stmt.innerHTML = `
      <h2 style="margin-bottom:8px;">Your Ikigai Statement</h2>
      <p style="font-size:16px;line-height:1.7;color:var(--text);font-style:italic;">"${ai.ikigaiStatement}"</p>
    `;
    document.getElementById('results').insertBefore(stmt, document.getElementById('results').firstChild);
  }
}

