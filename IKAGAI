const IKIGAI_QUESTIONS = [
  { id: 'love1', dimension: 'love', text: 'I lose track of time when I am doing this', placeholder: 'e.g. writing, coding, teaching...' },
  { id: 'love2', dimension: 'love', text: 'I would do this even if I were not paid', placeholder: 'e.g. designing, gardening...' },
  { id: 'love3', dimension: 'love', text: 'I actively seek out opportunities to do this', placeholder: 'e.g. public speaking, analyzing...' },
  { id: 'good1', dimension: 'good', text: 'People consistently ask for my help with this', placeholder: 'e.g. strategy, debugging, writing...' },
  { id: 'good2', dimension: 'good', text: 'I learn this faster than most people', placeholder: 'e.g. languages, systems thinking...' },
