  { id: 'paid3', dimension: 'paid', text: 'There is a clear market demand for this skill', placeholder: 'e.g. AI engineering, UX...' },
];

const SKILLS = [
  'JavaScript', 'Python', 'React', 'Node.js', 'SQL', 'Data Analysis',
  'UX Design', 'Graphic Design', 'Copywriting', 'Content Strategy',
  'Project Management', 'Public Speaking', 'Negotiation', 'Sales',
  'Teaching', 'Mentoring', 'Research', 'Critical Thinking',
  'Systems Thinking', 'Emotional Intelligence', 'Creativity', 'Writing',
  'Video Editing', 'Marketing', 'SEO', 'Product Management',
  'Financial Analysis', 'Operations', 'Customer Success', 'Strategy'
];

const BIGFIVE_QUESTIONS = [
  { id: 'o1', trait: 'Openness', text: 'I enjoy exploring unfamiliar ideas and experiences', reverse: false },
  { id: 'o2', trait: 'Openness', text: 'I prefer routine and familiar approaches', reverse: true },
  { id: 'c1', trait: 'Conscientiousness', text: 'I follow through on commitments consistently', reverse: false },
  { id: 'c2', trait: 'Conscientiousness', text: 'I often leave things unfinished', reverse: true },
  { id: 'e1', trait: 'Extraversion', text: 'I gain energy from social interaction', reverse: false },
  { id: 'e2', trait: 'Extraversion', text: 'I prefer working alone to working in groups', reverse: true },
  { id: 'a1', trait: 'Agreeableness', text: 'I prioritize others\' needs alongside my own', reverse: false },
  { id: 'a2', trait: 'Agreeableness', text: 'I can be blunt or critical when others make mistakes', reverse: true },
  { id: 'n1', trait: 'Emotional Stability', text: 'I remain calm under pressure', reverse: false },
  { id: 'n2', trait: 'Emotional Stability', text: 'I frequently feel anxious or overwhelmed', reverse: true },
];

// Curated O*NET-style occupational database
const OCCUPATIONS = [
